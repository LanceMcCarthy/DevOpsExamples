<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Telerik.Documents.Flow" Version="2026.3.923" />
    <PackageReference Include="Telerik.Documents.Flow.FormatProviders.Pdf" Version="2026.3.923" />
    <PackageReference Include="Telerik.Reporting" Version="20.2.26.812" />
    <PackageReference Include="Telerik.Reporting.OpenXmlRendering" Version="20.2.26.812" />
    <PackageReference Include="Telerik.Reporting.Services.AspNetCore" Version="20.2.26.812" />
    <PackageReference Include="Telerik.ReportViewer.BlazorNative" Version="20.2.26.812" />
    <PackageReference Include="Telerik.UI.for.Blazor" Version="15.0.1" />
    <PackageReference Include="Telerik.Drawing.Skia" Version="20.2.26.812" />
    <PackageReference Include="Telerik.Licensing" Version="1.9.3" ExcludeAssets="analyzers" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\css\site.css">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="Reports\Barcodes.trdp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
