<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <!-- Has skia dependencies preinstalled on top of mcr.microsoft.com/dotnet/aspnet:10.0 -->
    <ContainerBaseImage>docker.io/lancemccarthy/skia-aspnet:10.0</ContainerBaseImage>
    <ContainerRepository>lancemccarthy/myblazorapp</ContainerRepository>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Telerik.Documents.Flow" Version="2026.4.1109" />
    <PackageReference Include="Telerik.Documents.Flow.FormatProviders.Pdf" Version="2026.4.1109" />
    <PackageReference Include="Telerik.Reporting" Version="20.2.26.1007" />
    <PackageReference Include="Telerik.Reporting.OpenXmlRendering" Version="20.2.26.1007" />
    <PackageReference Include="Telerik.Reporting.Services.AspNetCore" Version="20.2.26.1007" />
    <PackageReference Include="Telerik.ReportViewer.BlazorNative" Version="20.2.26.1007" />
    <PackageReference Include="Telerik.UI.for.Blazor" Version="15.2.0" />
    <PackageReference Include="Telerik.Drawing.Skia" Version="20.2.26.1007" />
    <PackageReference Include="Telerik.Licensing" Version="1.11.3" ExcludeAssets="analyzers" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\css\site.css">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="Reports\Barcodes.trdp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
  <StaticWebAsset Remove="$(NuGetPackageRoot)telerik.reportviewer.blazornative\20.2.26.1007\staticwebassets\css\reporting-blazor-viewer.css.map" />
  <StaticWebAssetEndpoint Remove="_content/Telerik.ReportViewer.BlazorNative/css/reporting-blazor-viewer.css*.map" />
</ItemGroup>

</Project>
